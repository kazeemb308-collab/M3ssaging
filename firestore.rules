rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(data) { return signedIn() && request.auth.uid in data.memberIds; }

    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /chats/{chatId} {
      allow read, update, delete: if isMember(resource.data);
      allow create: if signedIn() && isMember(request.resource.data);

      match /messages/{messageId} {
        allow read: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
